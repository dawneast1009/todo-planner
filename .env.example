# Firebase 웹 앱 설정값 (Firebase 콘솔 → 프로젝트 설정 → 내 앱)
# 이 값들은 비밀 키가 아니라 공개 식별자지만, 레포에는 넣지 않고
# 로컬에서는 .env.local 에, 배포 시에는 GitHub 저장소 Variables 에 넣는다.
# 비워두면 이 기기에만 저장하는 로컬 모드로 동작한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 알림용 (선택). 프로젝트 설정 → 일반의 messagingSenderId, 클라우드 메시징 → 웹 푸시 인증서의 키 쌍
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
